{
  "name": "portfolio-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://chenwenjun.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenjunii/wenjun.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high",
    "check:content": "node --check src/data/content.js",
    "check:images": "node scripts/check-images.mjs",
    "test": "node --test scripts/check-images.test.mjs",
    "check": "npm run audit && npm run check:content && npm test && npm run check:images && npm run build",
    "deploy": "npm run check"
  },
  "devDependencies": {
    "vite": "^8.2.0"
  }
}
